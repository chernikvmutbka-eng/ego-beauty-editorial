# Обязательный секрет для подписи промокодов колеса (не менее 32 случайных символов)
WHEEL_SIGNING_SECRET=replace-with-a-long-random-secret

# Необязательный POST-адаптер проверки подписки: принимает { username }, возвращает { subscribed: boolean }
TELEGRAM_VERIFY_URL=

# Канонический production-адрес после публикации
NEXT_PUBLIC_SITE_URL=https://example.com

# Подключаются перед реальным запуском продаж
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CRM_WEBHOOK_URL=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_TOKEN=
YANDEX_METRIKA_ID=
